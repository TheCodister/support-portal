{
  "name": "@supportdesk/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:integration": "RUN_INTEGRATION_TESTS=true vitest run test/integration.test.ts test/cleanup.integration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.888.0",
    "@aws-sdk/s3-presigned-post": "3.888.0",
    "@aws-sdk/s3-request-presigner": "3.888.0",
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.1.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/rate-limit": "10.3.0",
    "@supportdesk/contracts": "workspace:*",
    "@supportdesk/database": "workspace:*",
    "fastify": "5.12.5",
    "zod": "4.6.5"
  },
  "devDependencies": { "@types/node": "24.3.1", "tsx": "4.20.6", "typescript": "5.9.3", "vitest": "3.2.4" }
}
