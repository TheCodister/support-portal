{
  "name": "supportdesk",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "dotenv -e .env -- pnpm --parallel --filter @supportdesk/api --filter @supportdesk/web dev",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:migrate": "dotenv -e .env -- pnpm --filter @supportdesk/database migrate",
    "db:seed": "dotenv -e .env -- pnpm --filter @supportdesk/database seed",
    "test:integration": "dotenv -e .env -- pnpm --filter @supportdesk/api test:integration",
    "infra": "pnpm --filter @supportdesk/infra"
  },
  "devDependencies": { "dotenv-cli": "11.0.0" }
}
